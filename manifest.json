{
  "manifest_version": 3,
  "name": "Prompt Auto-Saver",
  "version": "1.0",
  "description": "Saves textarea inputs locally to prevent data loss.",
  "permissions": ["storage", "tabs", "alarms"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "commands": {
    "open_popup": {
      "suggested_key": {
        "default": "Alt+Shift+S"
      },
      "description": "Open the Prompt Auto-Saver popup"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "*://chatgpt.com/*",
        "*://gemini.google.com/*",
        "*://claude.ai/*"
      ],
      "js": ["content.js"]
    }
  ]
}
