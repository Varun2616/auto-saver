{
  "manifest_version": 3,
  "name": "Prompt Auto-Saver",
  "version": "1.0",
  "description": "Saves textarea inputs locally to prevent data loss.",
  "permissions": ["storage", "alarms"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://chatgpt.com/*",
        "*://gemini.google.com/*",
        "*://claude.ai/*"
      ],
      "js": ["content.js"]
    }
  ]
}
