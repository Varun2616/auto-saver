{
  "manifest_version": 3,
  "name": "Prompt Auto-Saver",
  "version": "1.0",
  "description": "Saves textarea inputs locally to prevent data loss.",
  "permissions": ["storage", "tabs", "alarms", "scripting"],
  "optional_host_permissions": ["*://*/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "commands": {
    "open_popup": {
      "suggested_key": {
        "default": "Alt+Shift+S"
      },
      "description": "Open the Prompt Auto-Saver popup"
    }
  }
}
